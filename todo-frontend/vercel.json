{
  "rewrites": [
    { "source": "/auth", "destination": "https://worktodo2026.vercel.app/auth" },
    { "source": "/auth/:path*", "destination": "https://worktodo2026.vercel.app/auth/:path*" },
    { "source": "/tasks", "destination": "https://worktodo2026.vercel.app/tasks" },
    { "source": "/tasks/:path*", "destination": "https://worktodo2026.vercel.app/tasks/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
